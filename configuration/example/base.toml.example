# core/config/base.toml
[app]
service_name = "main-service"
service_version = "1.0.0"
service_host = "0.0.0.0"
service_port = 18090
title = "KM Portal"
description = "KM Portal Service"
debug = true
file_storage = "/home/ubuntu/km_portal/files/"
parser_workers = 2
parser_check_interval = 300

[app.log]
level = "DEBUG"
dir = "/home/ubuntu/km_portal/logs/"
rotation = "100 MB"
retention = "10 days"
api_log_enabled = true

[vlm]
service_name = "vlm-service"
service_version = "1.0.0"
service_host = "0.0.0.0"
service_port = 18092
timeout = 300
model_name = "qwen3-vl-plus"
provider = "api_qwen"
api_endpoint = "https://dashscope.aliyuncs.com/compatible-mode/v1"
max_tokens = 8192
temperature = 0.0

[llm]
service_name = "llm-service"
service_version = "1.0.0"
service_host = "0.0.0.0"
service_port = 18091
timeout = 300
model_name = "deepseek-chat"
provider = "api_deepseek"
api_endpoint = "https://api.deepseek.com/v1"
max_tokens = 8192
temperature = 0.0

[parser]
service_name = "parser-service"
service_version = "1.0.0"
service_host = "0.0.0.0"
service_port = 18093
timeout = 300

[parser.tokenizer]
en = "/home/ubuntu/models/embedding/bge-small-en-v1.5"
zh = "/home/ubuntu/models/embedding/bge-base-zh-v1.5"

[prompt]
image2text = "SYSTEM/image2text"
expand_synonyms = "SYSTEM/expand_synonyms"
fulltext_optimization = "SYSTEM/fulltext_optimization"


